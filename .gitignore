# Archivos compilados
bin/
*.class

# Datos generados por el programa (ignorar contenido pero mantener estructura)
data/*
!data/.gitkeep

# Respaldos generados en tiempo de ejecucion
backup/

# Temporales de escritura atomica
*.tmp

# Archivos de configuracion del editor
.vscode/
.idea/
*.swp
*.iml

# Archivos del sistema operativo
.DS_Store
Thumbs.db
Desktop.ini

# Archivos de log
*.log

# Documentacion interna
AGENTS.md
